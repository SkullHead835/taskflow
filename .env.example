# TaskFlow Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server Port
PORT=3000

# Runtime Environment (development, test, production)
NODE_ENV=development

# SQLite Database File Path (leave empty for default data/taskflow.db)
DB_PATH=./data/taskflow.db

# API Rate Limiting (window in ms and max requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
